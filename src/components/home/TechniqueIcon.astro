---
// Ícones personalizados da marca (arquivo icones_vanuza_soares.svg).
// Os desenhos são usados exatamente como no arquivo, centrados na mesma área
// para que os quatro cartões tenham o mesmo tamanho e a mesma proporção.
interface Props {
  name: 'microlink' | 'fita-adesiva' | 'ponto-americano' | 'manutencao';
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="-56 -56 112 112"
  fill="none"
  stroke="#D8BD83"
  stroke-width="3.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'microlink' && (
    <g>
      <circle cx="0" cy="0" r="28" />
      <circle cx="0" cy="0" r="21" opacity=".5" stroke-width="1.5" />
    </g>
  )}
  {name === 'fita-adesiva' && (
    <g>
      <ellipse cx="0" cy="-5" rx="28" ry="31" />
      <ellipse cx="0" cy="-5" rx="11" ry="14" />
      <path d="M-28 -5 V19 C-28 36 28 36 28 19 V-5" />
      <path d="M28 17 L48 31 L48 49 L25 34" />
    </g>
  )}
  {name === 'ponto-americano' && (
    <g>
      <path d="M-25 29 C-10 12 10 -8 29 -30" />
      <path d="M29 -30 L43 -43 L37 -22 Z" />
      <path d="M-25 29 C-39 41 -37 49 -26 44 C-12 38 -1 26 10 14" />
      <path d="M10 14 C22 2 36 5 35 17 C34 29 18 36 7 28" />
      <path d="M7 28 C-4 22 -10 36 0 43" />
    </g>
  )}
  {name === 'manutencao' && (
    <g>
      <rect x="-33" y="-27" width="66" height="66" rx="8" />
      <path d="M-33 -8 H33 M-17 -37 V-19 M17 -37 V-19" />
      <path d="M-18 8 H-6 M-18 21 H-10" />
      <path d="M0 17 L9 26 L25 8" />
    </g>
  )}
</svg>
