---
// Ícones da secção "Por que escolher Vanuza Soares?" (arquivos SVG enviados pela marca).
// Desenhos usados sem alteração, com champagne gold #B08D57 e fundo transparente.
interface Props {
  name: 'atendimento' | 'acabamento' | 'tecnicas' | 'experiencia' | 'autoestima' | 'resultados';
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  fill="none"
  stroke="#B08D57"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'atendimento' && (
    <>
      <path d="M12 29a14 14 0 0 1 25-9 14 14 0 0 1 15 13c0 8-7 14-15 14H25l-11 7 2-12A14 14 0 0 1 12 29Z" />
      <path d="M25 29c2-4 7-4 9 0 2-4 7-4 9 0 0 5-9 11-9 11s-9-6-9-11Z" />
    </>
  )}
  {name === 'acabamento' && (
    <>
      <path d="M18 49c-7-10-5-25 4-34 7-7 18-8 25-2 7 6 7 17 2 25-5 8-14 13-25 13" />
      <path d="M23 49c-3-10-1-21 6-29 5-6 11-9 17-9M29 50c-1-9 2-18 8-25 4-4 8-7 12-8" />
      <path d="M18 38c5 1 9 0 13-3M21 44c5 1 10 0 14-3" />
    </>
  )}
  {name === 'tecnicas' && (
    <>
      <path d="M13 18h38M17 25h30M20 32h24M23 39h18" />
      <path d="M16 13v31M22 13v31M28 13v31M34 13v31M40 13v31M46 13v31" />
      <path d="M14 49c8 5 28 5 36 0" />
    </>
  )}
  {name === 'experiencia' && (
    <>
      <path d="M32 7 38 12l8-1 3 8 7 5-3 8 1 8-8 4-4 8-10-2-10 2-4-8-8-4 1-8-3-8 7-5 3-8 8 1Z" />
      <path d="m23 32 6 6 13-14" />
      <path d="M32 15v4M32 45v4" />
    </>
  )}
  {name === 'autoestima' && (
    <>
      <path d="M32 52S9 39 9 23c0-8 10-13 17-6l6 6 6-6c7-7 17-2 17 6 0 16-23 29-23 29Z" />
      <path d="m44 8 2-4M51 14l5-1M43 15l-1-5" />
    </>
  )}
  {name === 'resultados' && (
    <>
      <circle cx="32" cy="32" r="23" />
      <path d="M24 42c-4-4-6-9-6-15 0-7 5-12 12-12s12 5 12 12c0 6-2 11-6 15" />
      <path d="M24 42c3 3 13 3 16 0M32 15v-4M47 20l4-4" />
      <path d="m47 39 2 4 4 2-4 2-2 4-2-4-4-2 4-2Z" />
    </>
  )}
</svg>
