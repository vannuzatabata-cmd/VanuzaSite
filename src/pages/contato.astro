---
import ContactForm from '@/components/ContactForm.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { metadata as siteMetadata, siteConfig } from '@/data/site';

const { address } = siteConfig.brand;
---

<BaseLayout
  title={siteMetadata.contact.title}
  description={siteMetadata.contact.description}
  path="/contato"
>
  <main class="min-h-[100dvh]">
    <section
      class="tone-marsala relative flex items-start overflow-hidden"
    >
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(ellipse at 50% 60%, rgba(152,73,92,0.25) 0%, transparent 60%)"
      ></div>
      <div class="page-hero-content relative max-w-4xl mx-auto px-5 sm:px-8 text-center w-full">
        <div class="flex items-center justify-center gap-3 mb-6">
          <div class="h-px w-8" style="background: var(--gold)"></div>
          <p class="text-xs font-bold uppercase tracking-[0.2em]" style="color: var(--gold)">Fale Conosco</p>
          <div class="h-px w-8" style="background: var(--gold)"></div>
        </div>
        <h1 class="page-title font-extrabold text-white mb-4">Agendamento de extensão capilar em Leiria</h1>
        <p class="text-lg max-w-lg mx-auto" style="color: rgba(255,255,255,0.75)">
          Entre em contacto para agendar o seu atendimento, esclarecer dúvidas ou saber mais sobre os cursos. Será um
          prazer atendê-la.
        </p>
      </div>
    </section>

    <section
      class="tone-nude section-standard"
    >
      <div class="max-w-2xl mx-auto px-5 sm:px-8">
        <div class="text-center mb-10">
          <div class="flex items-center justify-center gap-3 mb-4">
            <div class="h-px w-8" style="background: var(--gold)"></div>
            <p class="text-xs font-bold uppercase tracking-[0.2em]" style="color: var(--gold)">
              Mensagem Rápida
            </p>
            <div class="h-px w-8" style="background: var(--gold)"></div>
          </div>
          <h2 class="section-title font-extrabold text-white">Envie uma mensagem</h2>
          <p class="text-sm mt-3" style="color: rgba(255,255,255,0.72)">
            Preencha os dados abaixo e envie a mensagem diretamente pelo WhatsApp.
          </p>
        </div>
        <ContactForm />
      </div>
    </section>

    <section
      class="tone-marsala section-standard"
    >
      <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <div class="text-center mb-12">
          <h2 class="section-title font-extrabold text-white">Outros canais</h2>
        </div>
        <div class="flex flex-col items-center gap-6 mx-auto max-w-2xl">
          <article class="w-full rounded-2xl p-8 sm:p-10 flex flex-col items-center text-center" style="background: rgba(96,36,56,0.45); border: 1px solid rgba(255,255,255,0.22)">
            <div
              class="w-14 h-14 rounded-2xl flex items-center justify-center mb-6"
              style="background: rgba(255,255,255,0.15)"
            >
              <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
                <path d="M16 0C7.163 0 0 7.163 0 16c0 2.906.773 5.63 2.123 7.984L0 32l8.29-2.09A15.93 15.93 0 0016 32c8.837 0 16-7.163 16-16S24.837 0 16 0zm8.066 22.468c-.336.94-1.652 1.72-2.72 1.946-.726.155-1.673.278-4.862-1.046-4.084-1.666-6.715-5.814-6.916-6.08-.193-.267-1.618-2.155-1.618-4.11 0-1.954 1.017-2.912 1.383-3.303.336-.368.73-.46 1.017-.46.193 0 .385.002.553.01.193.01.46-.073.723.55.27.64 1.018 2.45 1.106 2.63.09.18.15.39.03.63-.12.24-.18.39-.36.6-.18.21-.378.47-.54.63-.18.18-.367.374-.158.734.21.36.934 1.54 2.003 2.493 1.376 1.225 2.537 1.604 2.897 1.784.36.18.57.15.78-.09.21-.24.9-1.05 1.14-1.41.24-.36.48-.3.81-.18.33.12 2.1 1.024 2.46 1.21.36.18.6.27.69.42.09.15.09.84-.246 1.78z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-extrabold text-white mb-2">WhatsApp</h3>
            <p class="text-white/70 text-sm leading-relaxed mb-8 flex-grow">
              O caminho mais rápido. Respondemos no mesmo dia com atenção e carinho. Agende, tire dúvidas ou só
              diga olá!
            </p>
            <a
              href={siteConfig.brand.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="button-primary rounded-xl"
            >
              Chamar no WhatsApp
              <span class="sr-only">, abre num novo separador</span>
            </a>
          </article>

          <article class="w-full rounded-2xl p-8 sm:p-10 flex flex-col items-center text-center" style="background: rgba(96,36,56,0.45); border: 1px solid rgba(255,255,255,0.22)">
            <div
              class="w-14 h-14 rounded-2xl flex items-center justify-center mb-6"
              style="background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045)"
            >
              <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-extrabold text-white mb-2">Instagram</h3>
            <p class="text-sm leading-relaxed mb-8 flex-grow" style="color: rgba(255,255,255,0.72)">
              Acompanhe resultados, novidades e conteúdos no Instagram oficial.
            </p>
            <a
              href={siteConfig.brand.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 px-7 py-3 rounded-xl font-bold text-sm text-white transition-colors hover:bg-white/10"
              style="background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045)"
            >
              Seguir {siteConfig.brand.instagram}
              <span class="sr-only">, abre num novo separador</span>
            </a>
          </article>

          <article class="w-full rounded-2xl p-8 sm:p-10 flex flex-col items-center text-center" style="background: rgba(96,36,56,0.45); border: 1px solid rgba(255,255,255,0.22)">
            <div
              class="w-14 h-14 rounded-2xl flex items-center justify-center mb-6"
              style="background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045)"
            >
              <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-extrabold text-white mb-2">Instagram Portugal</h3>
            <p class="text-sm leading-relaxed mb-8 flex-grow" style="color: rgba(255,255,255,0.72)">
              Acompanhe resultados, novidades e conteúdos do perfil criado para os seguidores em Portugal.
            </p>
            <a
              href="https://www.instagram.com/extensaocapilarportugal_leiria?jplx=MXdibTV0N2ZjZHZh&utm_source=qr"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 px-7 py-3 rounded-xl font-bold text-sm text-white transition-colors hover:bg-white/10"
              style="background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045)"
            >
              Seguir @extensaocapilarportugal_leiria
              <span class="sr-only">, abre num novo separador</span>
            </a>
          </article>
          <article class="w-full rounded-2xl p-8 sm:p-10 flex flex-col items-center text-center" style="background: rgba(96,36,56,0.45); border: 1px solid rgba(255,255,255,0.22)">
            <div
              class="w-14 h-14 rounded-2xl flex items-center justify-center mb-6"
              style="background: #FF0000"
            >
              <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-extrabold text-white mb-2">YouTube</h3>
            <p class="text-sm leading-relaxed mb-8 flex-grow" style="color: rgba(255,255,255,0.72)">
              Assista aos vídeos das técnicas, resultados e novidades no canal oficial.
            </p>
            <a
              href="https://youtube.com/@vanuzasoaresextensoes?si=Uzq3_IAlbksBaaIL"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 px-7 py-3 rounded-xl font-bold text-sm text-white transition-colors hover:bg-white/10"
              style="background: #FF0000"
            >
              Assistir no YouTube
              <span class="sr-only">, abre num novo separador</span>
            </a>
          </article>
        </div>
      </div>
    </section>

    <section
      class="tone-nude section-standard"
    >
      <div class="max-w-4xl mx-auto px-5 sm:px-8">
        <div class="text-center mb-12">
          <h2 class="section-title font-extrabold text-white">Informações úteis</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-14">
          <article
            class="rounded-2xl p-7 flex flex-col items-center text-center"
            style="background: rgba(96,36,56,0.45); border: 1px solid rgba(96,36,56,0.45)"
          >
            <span class="text-4xl block mb-4" aria-hidden="true">📍</span>
            <h3 class="text-white font-extrabold text-base mb-2">Localização</h3>
            <address class="not-italic text-sm leading-relaxed mb-4" style="color: rgba(255,255,255,0.72)">
              Leiria, Portugal
            </address>

            <div class="w-full rounded-xl overflow-hidden mb-4" style="height: 160px">
              <iframe
                src="https://maps.google.com/maps?q=Leiria+Portugal&output=embed"
                width="100%"
                height="160"
                style="border: 0; display: block"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Localização Vanuza Soares"
              ></iframe>
            </div>

            <a
              href={siteConfig.brand.mapsSearchUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-1.5 text-xs font-bold px-4 py-2 rounded-lg transition-colors hover:bg-white/10"
              style="background: rgba(198,161,91,0.15); color: var(--gold); border: 1px solid rgba(198,161,91,0.25)"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                ></path>
              </svg>
              Abrir no Google Maps
              <span class="sr-only">, abre num novo separador</span>
            </a>
          </article>

          <article
            class="rounded-2xl p-7 flex flex-col items-center text-center"
            style="background: rgba(96,36,56,0.45); border: 1px solid rgba(96,36,56,0.45)"
          >
            <span class="text-4xl block mb-4" aria-hidden="true">⏰</span>
            <h3 class="text-white font-extrabold text-base mb-2">Horários</h3>
            <p class="text-sm leading-relaxed" style="color: rgba(255,255,255,0.72)">
              Atendimento com hora marcada. Consulte a disponibilidade pelo WhatsApp.
            </p>
          </article>

          <article
            class="rounded-2xl p-7 flex flex-col items-center text-center"
            style="background: rgba(96,36,56,0.45); border: 1px solid rgba(96,36,56,0.45)"
          >
            <span class="text-4xl block mb-4" aria-hidden="true">📅</span>
            <h3 class="text-white font-extrabold text-base mb-2">Agendamento</h3>
            <p class="text-sm leading-relaxed" style="color: rgba(255,255,255,0.72)">
              Agenda com antecedência recomendada. Reserve o seu lugar pelo WhatsApp.
            </p>
          </article>
        </div>

        <nav aria-labelledby="explore-site-title">
          <h3 id="explore-site-title" class="text-white font-extrabold text-xl mb-6 text-center">
            Explore o site
          </h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            {
              siteConfig.pages
                .filter((page) => page.path !== '/contato')
                .map((page) => (
                  <a
                    href={page.path}
                    class="flex items-center justify-between rounded-xl px-5 py-4 text-sm font-bold transition-all hover:-translate-y-0.5"
                    style="background: rgba(96,36,56,0.45); border: 1px solid rgba(255,255,255,0.06); color: rgba(255,255,255,0.7)"
                  >
                    {page.name}
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      ></path>
                    </svg>
                  </a>
                ))
            }
          </div>
        </nav>
      </div>
    </section>

    <section class="tone-marsala section-compact">
      <div class="max-w-2xl mx-auto px-5 sm:px-8 text-center">
        <h2 class="section-title font-extrabold text-white mb-4">Pronta para transformar o seu visual?</h2>
        <p class="text-white/95 mb-8">Fale agora pelo WhatsApp. Respondemos com atenção e cuidado.</p>
        <a
          href={siteConfig.brand.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="button-primary"
        >
          Enviar mensagem no WhatsApp
          <span class="sr-only">, abre num novo separador</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
