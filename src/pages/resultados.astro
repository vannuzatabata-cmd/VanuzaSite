---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { resultImages } from '@/data/gallery';
import { metadata as siteMetadata, siteConfig } from '@/data/site';

const reviews = [
  {
    id: 'sil-silva',
    name: 'Sil Silva',
    year: '2026',
    quote:
      'Trabalha muito bem com a técnica do microlink para cacheadas… além de melhorar minha autoestima.',
  },
  {
    id: 'larissa-roberta',
    name: 'Larissa Roberta',
    year: '2026',
    quote:
      'Já estou com ela há mais de 3 anos. Moro em outra cidade e vou para BH só para fazer minhas manutenções com ela.',
  },
  {
    id: 'leticia-cae',
    name: 'Letícia Caé',
    year: '2026',
    quote: 'Serviço e atendimento excelente! Super indico.',
  },
];

const checkedAt = new Intl.DateTimeFormat('pt-PT', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${siteConfig.brand.googleRating.checkedAt}T12:00:00Z`));

const getResponsiveSrcSet = (src: string) => {
  const base = src.slice(0, -5);
  return `${base}-320.webp 320w, ${base}-480.webp 480w, ${base}-800.webp 800w, ${src} 1200w`;
};
---

<BaseLayout
  title={siteMetadata.results.title}
  description={siteMetadata.results.description}
  path="/resultados"
>
  <main class="min-h-[100dvh]">
    <section
      class="tone-marsala relative flex items-start overflow-hidden"
    >
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(ellipse at 60% 50%, rgba(152,73,92,0.25) 0%, transparent 60%)"
      ></div>
      <div class="page-hero-content relative max-w-4xl mx-auto px-5 sm:px-8 text-center w-full">
        <div class="flex items-center justify-center gap-3 mb-6">
          <div class="h-px w-8" style="background: var(--gold)"></div>
          <p class="text-xs font-bold uppercase tracking-[0.2em]" style="color: var(--gold)">
            Prova Real
          </p>
          <div class="h-px w-8" style="background: var(--gold)"></div>
        </div>
        <h1 class="page-title font-extrabold text-white mb-4">
          Resultados de extensão capilar em Leiria
        </h1>
        <p class="text-lg max-w-xl mx-auto" style="color: rgba(255,255,255,0.75)">
          Resultados reais que valorizam cada detalhe. Uma galeria de transformações feitas com técnica,
          cuidado e acabamento natural.
        </p>
      </div>
    </section>

    <section class="tone-nude" aria-label="Números da Vanuza Soares Extensões">
      <div class="max-w-xl mx-auto px-5 sm:px-8 py-6 grid grid-cols-2 divide-x divide-white/20">
        {
          [
            { value: `${siteConfig.stats.yearsExperience}+`, label: 'Anos de experiência' },
            {
              value: siteConfig.brand.googleRating.value.toFixed(1).replace('.', ','),
              label: 'Nota no Google',
            },
          ].map((stat) => (
            <div class="text-center px-2 sm:px-4">
              <p class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white">{stat.value}</p>
              <p class="text-white/80 text-xs font-medium mt-1 leading-tight">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="tone-marsala section-standard"
    >
      <div class="max-w-7xl mx-auto px-5 sm:px-8">
        <div class="text-center mb-14">
          <div class="flex items-center justify-center gap-3 mb-4">
            <div class="h-px w-8" style="background: var(--gold)"></div>
            <p class="text-xs font-bold uppercase tracking-[0.2em]" style="color: var(--gold)">Galeria</p>
            <div class="h-px w-8" style="background: var(--gold)"></div>
          </div>
          <h2 class="section-title font-extrabold text-white">Resultados Reais</h2>
          <p class="mt-3 text-base max-w-lg mx-auto" style="color: rgba(255,255,255,0.72)">
            Galeria completa de trabalhos realizados por Vanuza Soares Extensões Capilares.
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-3 md:gap-4">
          {
            resultImages.map((image) => (
              <figure class="relative overflow-hidden rounded-xl group" style="aspect-ratio: 1 / 1">
                <img
                  src={image.src}
                  srcset={getResponsiveSrcSet(image.src)}
                  sizes="(min-width: 1280px) 288px, (min-width: 1024px) calc(25vw - 1.5rem), (min-width: 768px) calc(33vw - 1.5rem), calc(50vw - 1.5rem)"
                  alt={image.alt}
                  width="1200"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                  class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-110"
                />
                <figcaption
                  class="absolute inset-0 flex flex-col justify-end p-4 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300"
                  style="background: linear-gradient(to top, rgba(144,73,92,0.85) 0%, transparent 55%)"
                >
                  <span class="text-white text-xs font-bold tracking-wide">{image.label}</span>
                  <span class="text-xs" style="color: rgba(255,255,255,0.75)">
                    @vanuzasoaresextensoes
                  </span><span class="block text-xs" style="color: rgba(255,255,255,0.75)">@extensaocapilarportugal_leiria</span>
                </figcaption>
              </figure>
            ))
          }
        </div>

        <div
          class="mt-12 rounded-2xl p-8 sm:p-10 text-center"
          style="background: rgba(96,36,56,0.45); border: 1px solid rgba(255,255,255,0.22)"
        >
          <p class="font-extrabold text-white text-xl mb-2">Transformações reais no Instagram</p>
          <p class="text-sm mb-6" style="color: rgba(255,255,255,0.72)">
            Acompanhe os trabalhos diários, novidades e resultados em primeira mão em {
              siteConfig.brand.instagram
            } e @extensaocapilarportugal_leiria
          </p>
          <div class="flex flex-col items-center justify-center gap-3 sm:flex-row"><a
            href={siteConfig.brand.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="button-secondary"
            style="background: linear-gradient(135deg, var(--primary-deep), var(--primary))"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path>
            </svg>
            Seguir {siteConfig.brand.instagram} e @extensaocapilarportugal_leiria
            <span class="sr-only">, abre em nova aba</span>
          </a><a
            href="https://www.instagram.com/extensaocapilarportugal_leiria?jplx=MXdibTV0N2ZjZHZh&utm_source=qr"
            target="_blank"
            rel="noopener noreferrer"
            class="button-secondary"
            style="background: linear-gradient(135deg, var(--primary-deep), var(--primary))"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path>
            </svg>
            Seguir @extensaocapilarportugal_leiria
            <span class="sr-only">, abre em nova aba</span>
          </a></div>
        </div>
      </div>
    </section>

    <section
      id="avaliacoes"
      aria-labelledby="avaliacoes-titulo"
      class="tone-nude scroll-mt-24 section-compact"
    >
      <div class="site-container">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow mb-2">Avaliações no Google</p>
            <h2 id="avaliacoes-titulo" class="text-2xl sm:text-3xl font-extrabold text-white">
              O que as clientes dizem
            </h2>
          </div>

          <div
            class="flex items-center gap-3"
            aria-label={`${siteConfig.brand.googleRating.value} de 5 estrelas no Google`}
          >
            <strong class="text-3xl font-extrabold leading-none text-white">
              {siteConfig.brand.googleRating.value.toFixed(1).replace('.', ',')}
            </strong>
            <div>
              <div class="text-sm tracking-[0.08em]" style="color: var(--gold)" aria-hidden="true">
                ★★★★★
              </div>
            </div>
          </div>
        </div>

        <div
          class="-mx-5 mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-2 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-4 sm:overflow-visible sm:px-0 sm:pb-0"
          aria-label="Destaques das avaliações"
        >
          {
            reviews.map((review) => (
              <figure
                class="min-h-44 min-w-[82vw] snap-start rounded-xl p-5 flex flex-col justify-between sm:min-w-0"
                style="background: rgba(255,255,255,0.045); border: 1px solid rgba(255,255,255,0.09)"
              >
                <blockquote class="text-sm text-white/85 font-medium leading-6">
                  “{review.quote}”
                </blockquote>
                <figcaption class="mt-5 text-xs">
                  <cite class="not-italic font-bold text-white">{review.name}</cite>
                  <span class="text-white/70"> · Google, {review.year}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>

        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-xs text-white/70">Dados consultados em {checkedAt}.</p>
          <a
            href={siteConfig.brand.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center justify-center rounded-lg px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand-deep"
            style="background: var(--primary)"
          >
            Ver todas no Google
            <span class="sr-only">, abre em nova aba</span>
          </a>
        </div>
      </div>
    </section>

    <section class="tone-marsala section-compact">
      <div class="max-w-2xl mx-auto px-5 sm:px-8 text-center">
        <h2 class="section-title font-extrabold text-white mb-4">Seja a próxima</h2>
        <p class="text-white/95 mb-8 text-base">
          Agende a sua avaliação e descubra qual técnica combina com o seu cabelo, a sua rotina e o resultado
          desejado.
        </p>
        <a
          href={siteConfig.brand.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="button-primary"
        >
          Agendar pelo WhatsApp
          <span class="sr-only">, abre em nova aba</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
