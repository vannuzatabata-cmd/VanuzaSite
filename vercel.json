{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/opengraph-image",
      "destination": "/opengraph-image.png",
      "permanent": true
    },
    {
      "source": "/icon",
      "destination": "/icon.png",
      "permanent": true
    },
    {
      "source": "/servicos/microlink",
      "destination": "/tecnicas#microlink",
      "permanent": true
    },
    {
      "source": "/servicos/fita-adesiva",
      "destination": "/tecnicas#fita-adesiva",
      "permanent": true
    },
    {
      "source": "/servicos/ponto-americano",
      "destination": "/tecnicas#ponto-americano",
      "permanent": true
    }
  ]
}